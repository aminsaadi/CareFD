# ==================== REQUIRED ====================

# PostgreSQL connection string (with PostGIS extension enabled)
DATABASE_URL="postgresql://user:password@localhost:5432/carefd"

# JWT signing secret (min 32 characters, generate with: openssl rand -base64 32)
SECRET_KEY="your-secret-key-min-32-characters"

# ==================== EMAIL (at least one required) ====================

# Resend API key (recommended for Railway deployment)
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# Sender email address
SENDER_EMAIL="noreply@carefd.com"

# ==================== OPTIONAL ====================

# Site URL (used in email links)
NEXT_PUBLIC_SITE_URL="https://carefd.com"

# CORS allowed origins (comma-separated)
CORS_ORIGINS="https://carefd.com,https://www.carefd.com"

# Push notifications (VAPID keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Node environment
NODE_ENV="production"
